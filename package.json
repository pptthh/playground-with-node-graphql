{
  "name": "playground-with-node-graphql",
  "version": "0.0.1",
  "description": "playing with node and graphql nextjs to learn",
  "main": "dist/index.js",
  "scripts": {
    "clean": "pnpm cache delete && rm -rf dist .next",
    "clean-dev": "pnpm clean && pnpm i && pnpm lint && pnpm build && pnpm dev",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cy": "pnpm cy:open",
    "cy:debug": "DEBUG=cypress:* pnpm cy:open --browser electron",
    "cy:open": "DISPLAY= cypress open",
    "cy:run": "DISPLAY= cypress run"
  },
  "keywords": [
    "node",
    "graphql",
    "typescript",
    "api",
    "nextjs",
    "learning",
    "tracker"
  ],
  "author": "Tóth Péter",
  "license": "ISC",
  "dependencies": {
    "graphql": "16.9.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@rushstack/eslint-patch": "1.15.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "25.2.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/uuid": "9.0.0",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cypress": "15.10.0",
    "cypress-dark": "1.8.3",
    "eslint": "10.0.0",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "jiti": "2.6.1",
    "next": "15.1.4",
    "postcss": "8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "3.4.19",
    "ts-node": "10.9.2",
