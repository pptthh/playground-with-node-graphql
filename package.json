{
  "name": "playground-with-node-graphql",
  "version": "0.0.1",
  "description": "playing with node and graphql nextjs to learn",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist .next",
    "clean-dev": "pnpm run clean && pnpm i && pnpm run dev",
    "dev": "node scripts/emit-postcss-cjs.js && next dev",
    "build": "node scripts/emit-postcss-cjs.js && next build",
    "start": "node scripts/emit-postcss-cjs.js && next start",
    "check": "eslint",
    "lint": "NODE_OPTIONS='-r ts-node/register' eslint",
    "test:postcss": "node test/validate-postcss-config.js"
  },
  "keywords": [
    "node",
    "graphql",
    "typescript",
    "api",
    "nextjs",
    "learning",
    "tracker"
  ],
  "author": "Tóth Péter",
  "license": "ISC",
  "dependencies": {
    "graphql": "16.9.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@rushstack/eslint-patch": "1.15.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "25.2.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/uuid": "9.0.0",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.0.0",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "jiti": "2.6.1",
    "next": "15.1.4",
    "postcss": "8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "3.4.19",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@10.29.2"
}
